 <section class="mx-3 mt-5" style="color: aliceblue;">

    <div class="container">

        <h1>
            Welcome, <span class="text-primary">Admin</span>
        </h1>

        <p>List of logged teams</p>

        <div class="row">

            {{#each teams}}

            <div class="col-12 col-sm-6 col-lg-3 mb-4">

                <div class="card h-100">

                    <div class="card-body">

                        <h5 class="card-title">
                            {{tName}}
                        </h5>

                        <h6 class="card-subtitle mb-2 text-primary">
                            Team Leader
                        </h6>

                        <p class="card-text">
                            Name: {{lName}}<br>
                            Gmail: {{lEmail}}
                        </p>

                        <h6 class="card-subtitle mb-2 text-body-secondary">
                            Team Members
                        </h6>

                        <p class="card-text">
                            M1 Name: {{m1Name}}<br>
                            M1 Gmail: {{m1Email}}
                        </p>

                        <p class="card-text">
                            M2 Name: {{m2Name}}<br>
                            M2 Gmail: {{m2Email}}
                        </p>

                        <p class="card-text">
                            M3 Name: {{m3Name}}<br>
                            M3 Gmail: {{m3Email}}
                        </p>

                        <p class="card-text">
                            M4 Name: {{m4Name}}<br>
                            M4 Gmail: {{m4Email}}
                        </p>
<form action="/admin/approve/{{_id}}" method="post">
                        <button class="btn btn-success">
                            Approve
                        </button>
</form>
<form action="/admin/reject/{{_id}}" method="post">
                        <button class="btn btn-danger">
                            Reject
                        </button>
</form>
                    </div>

                </div>

            </div>

            {{/each}}

        </div>

    </div>

</section>