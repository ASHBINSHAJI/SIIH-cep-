<section class="confirmation-section">

    <div class="container">

        <!-- PAGE HEADER -->
        <div class="confirmation-header">

            <span class="section-label">
                INTERNAL HACKATHON 2026
            </span>

            <h1>Team Confirmation</h1>

            <p>
                Review and submit your team details to complete registration.
            </p>

        </div>


        <form action="/team-confirmation" method="POST" class="confirmation-form">


            <!-- =========================
                 TEAM INFORMATION
            ========================== -->

            <div class="form-card">

                <div class="card-heading">
                    <div class="step-number">01</div>

                    <div>
                        <h2>Team Information</h2>
                        <p>Confirm your registered team details.</p>
                    </div>
                </div>


                <div class="row g-4">

                    <div class="col-12">

                        <label for="tName">
                            Team Name
                        </label>

                        <input
                            type="text"
                            id="teamName"
                            name="tName"
                            placeholder="Enter your team name"
                            required
                        >

                    </div>

                </div>

            </div>


            <!-- =========================
                 TEAM LEADER
            ========================== -->

            <div class="form-card">

                <div class="card-heading">

                    <div class="step-number">02</div>

                    <div>
                        <h2>Team Leader</h2>
                        <p>Enter the leader's registered details.</p>
                    </div>

                </div>


                <div class="row g-4">

                    <div class="col-md-6">

                        <label for="leaderName">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="leaderName"
                            name="lName"
                            placeholder="Leader full name"
                            required
                        >

                    </div>


                    <div class="col-md-6">

                        <label for="leaderEmail">
                            Gmail
                        </label>

                        <input
                            type="email"
                            id="leaderEmail"
                            name="lEmail"
                            placeholder="leader@gmail.com"
                            required
                        >

                    </div>

                </div>

            </div>


            <!-- =========================
                 TEAM MEMBERS
            ========================== -->

            <div class="form-card">

                <div class="card-heading">

                    <div class="step-number">03</div>

                    <div>
                        <h2>Team Members</h2>
                        <p>Enter the details of your team members.</p>
                    </div>

                </div>


                <div class="members-grid">


                    <!-- MEMBER 01 -->

                    <div class="member-card">

                        <div class="member-number">
                            MEMBER 01
                        </div>

                        <label for="member1Name">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="member1Name"
                            name="m1Name"
                            placeholder="Member full name"
                            required
                        >

                        <label for="member1Email">
                            Gmail
                        </label>

                        <input
                            type="email"
                            id="member1Email"
                            name="m1Email"
                            placeholder="member@gmail.com"
                            required
                        >

                    </div>


                    <!-- MEMBER 02 -->

                    <div class="member-card">

                        <div class="member-number">
                            MEMBER 02
                        </div>

                        <label for="member2Name">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="member2Name"
                            name="m2Name"
                            placeholder="Member full name"
                            required
                        >

                        <label for="member2Email">
                            Gmail
                        </label>

                        <input
                            type="email"
                            id="member2Email"
                            name="m2Email"
                            placeholder="member@gmail.com"
                            required
                        >

                    </div>


                    <!-- MEMBER 03 -->

                    <div class="member-card">

                        <div class="member-number">
                            MEMBER 03
                        </div>

                        <label for="member3Name">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="member3Name"
                            name="mr3Name"
                            placeholder="Member full name"
                            required
                        >

                        <label for="member3Email">
                            Gmail
                        </label>

                        <input
                            type="email"
                            id="member3Email"
                            name="m3Email"
                            placeholder="member@gmail.com"
                            required
                        >

                    </div>


                    <!-- MEMBER 04 -->

                    <div class="member-card">

                        <div class="member-number">
                            MEMBER 04
                        </div>

                        <label for="member4Name">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="member4Name"
                            name="m4Name"
                            placeholder="Member full name"
                            required
                        >

                        <label for="member4Email">
                            Gmail
                        </label>

                        <input
                            type="email"
                            id="member4Email"
                            name="m4Email"
                            placeholder="member@gmail.com"
                            required
                        >

                    </div>

                </div>

            </div>


            <!-- =========================
                 VERIFICATION
            ========================== -->

            <div class="form-card">

                <div class="card-heading">

                    <div class="step-number">04</div>

                    <div>
                        <h2>Verification</h2>
                        <p>Confirm your team before submitting.</p>
                    </div>

                </div>


                <div class="verification-box">

                    <div class="verification-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div>
                        <h3>Ready to submit?</h3>

                        <p>
                            Make sure all team details are correct.
                            You won't be able to change them after submission
                            without admin approval.
                        </p>
                    </div>

                </div>


                <div class="form-check confirmation-check">

                    <input
                        class="form-check-input"
                        type="checkbox"
                        id="confirmDetails"
                        name="confirmDetails"
                        required
                    >

                    <label
                        class="form-check-label"
                        for="confirmDetails"
                    >
                        I confirm that the information provided above
                        is correct.
                    </label>

                </div>

            </div>


            <!-- =========================
                 SUBMIT
            ========================== -->

            <div class="submit-area">

                <button
                    type="submit"
                    class="submit-btn"
                >
                    Submit Team
                    <i class="bi bi-arrow-right"></i>
                </button>

                <p>
                    <i class="bi bi-info-circle"></i>
                    Your registration will be reviewed by the administrators.
                </p>

            </div>


        </form>

    </div>
