<section class="approval-section">

    {{#if team}}

    <div class="approval-card">

        <!-- Congratulations -->
        <div class="success-icon">
            ✓
        </div>

        <div class="approval-header">
            <h1>Congratulations! 🎉</h1>
            <p>Your team has been successfully approved.</p>
        </div>

        <!-- Important Information -->
        <div class="credential-box">

            <h2>Team Login Credentials</h2>

            <p class="credential-info">
                Use the following credentials to access your team dashboard.
            </p>

            <div class="credential">
                <span>Team ID</span>
                <strong>{{team.teamid}}</strong>
            </div>

            <div class="credential">
                <span>Password</span>
                <strong>{{team.displaypassword}}</strong>
            </div>

        </div>

        <!-- Warning -->
        <div class="warning-box">
            <strong>Important:</strong>
            <p>
                Please save or write down your Team ID and Password.
                You will need these credentials to log in to your dashboard.
            </p>
        </div>

        <!-- Dashboard -->
        <a href="/team-login" class="dashboard-btn">
            Go to Team Login
        </a>

    </div>

    {{/if}}

</section>

