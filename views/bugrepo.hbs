
<section class="report-page">

    <div class="report-container">

        <!-- Header -->
        <div class="report-header">

            <span class="report-badge">
                <i class="bi bi-headset"></i>
                Developer Support
            </span>

            <h1>
                Report an <span>Issue</span>
            </h1>

            <p>
                Found a bug or something isn't working correctly?
                Let us know and we'll look into it.
            </p>

        </div>


        <!-- Report Form -->
        <div class="report-card">

            <form id="reportForm">

                <div class="form-group">

                    <label for="issue">
                        Issue Type
                    </label>

                    <select id="issue" name="issue" required>

                        <option value="" disabled selected>
                            Select an issue
                        </option>

                        <option value="Bug / Error">
                            Bug / Error
                        </option>

                        <option value="Login Problem">
                            Login Problem
                        </option>

                        <option value="Dashboard Problem">
                            Dashboard Problem
                        </option>

                        <option value="Submission Problem">
                            Submission Problem
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label for="admin">
                     Admin
                    </label>
                    <input
                        type="text"
                        id="teamid"
                        name="teamid"
                        placeholder="Enter your Team ID"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="message">
                        Describe the Problem
                    </label>

                    <textarea
                        id="message"
                        name="message"
                        rows="6"
                        placeholder="Explain what happened..."
                        required
                    ></textarea>

                </div>


                <button type="submit" class="submit-report">

                    <i class="bi bi-send"></i>
                    Send Report

                </button>

            </form>

        </div>


        <p class="report-footer">
            Please provide as much information as possible so the
            development team can resolve the issue quickly.
        </p>

    </div>

</section>


<script>

document.getElementById("reportForm").addEventListener("submit", function (event) {

    event.preventDefault();

    // Get form values
    const issue = document.getElementById("issue").value;
    const teamid = document.getElementById("teamid").value;
    const message = document.getElementById("message").value;


    // Your WhatsApp number
    const whatsappNumber = "919645013535";


    // Message sent to WhatsApp
    const whatsappMessage = `
🚨 SIIH HACKATHON - ISSUE REPORT

━━━━━━━━━━━━━━━━━━

📌 Issue Type:
${issue}

👥 Team ID:
${teamid}

📝 Problem:
${message}

━━━━━━━━━━━━━━━━━━
Sent from SIIH Hackathon Support
`;


    // Create WhatsApp URL
    const whatsappURL =
        "https://wa.me/" +
        whatsappNumber +
        "?text=" +
        encodeURIComponent(whatsappMessage);


    // Open WhatsApp
    window.open(whatsappURL, "_blank");

});

</script>
