
<section class="team-login-section">

    <div class="team-login-card">

        <div class="login-header">
            <div class="login-icon">
                <i class="bi bi-people-fill"></i>
            </div>

            <h1>Team Login</h1>
            <p>Enter your team details to access the dashboard.</p>
        </div>

        <form action="/login" method="POST">

            {{#if error}}
                <div class="alert alert-danger"
                     style="padding: 0.75rem; background: #3d0000; border: 1px solid #f44336; border-radius: 8px; color: #ff9999; margin-bottom: 1rem; font-size: 0.9rem;">
                    {{error}}
                </div>
            {{/if}}

            <!-- Team Leader -->
            <div class="form-group">
                <label for="lname">Team Leader Name</label>

                <input
                   style="background-color: rgb(0, 0, 0);"
                    type="text"
                    id="lname"
                    name="lname"
                    placeholder="Enter leader name"
                    required
                >
            </div>

            <!-- Team Name -->
            <div class="form-group">
                <label for="teamName">Team Name</label>

                <input
                style="background-color: rgb(0, 0, 0);"
                    type="text"
                    id="teamName"
                    name="teamName"
                    placeholder="Enter team name"
                    required
                >
            </div>

            <!-- Team ID -->
            <div class="form-group">
                <label for="teamid">Team ID</label>

                <input
                   style="background-color: rgb(0, 0, 0);"
                    type="text"
                    id="teamid"
                    name="teamid"
                    placeholder="SIIH2026@1"
                    required
                >
            </div>

            <!-- Password -->
            <div class="form-group">
                <label for="password">Password</label>

                <input
                   style="background-color: rgb(0, 0, 0);"
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter password"
                    required
                >
            </div>

            <button type="submit" class="login-btn">
                <i class="bi bi-box-arrow-in-right"></i>
                Enter Dashboard
            </button>

        </form>

        <p class="login-note">
            Use the credentials provided by the hackathon organizers.
        </p>

    </div>

</section>

