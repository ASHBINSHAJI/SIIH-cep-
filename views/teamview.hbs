﻿<section class="dashboard-section">
{{#with team}}
    <div class="container">

        <!-- HEADER -->
        <div class="dashboard-header dashboard-reveal">

            <div>
                <span class="dashboard-eyebrow">TEAM DASHBOARD</span>

                <h1>
                    Welcome,
                    <span class="text-primary">{{teamName}}</span>
                </h1>

                <p>
                    Manage your team, track assignments and submit your work.
                </p>
            </div>

            <div class="team-badge">
                <span class="status-dot"></span>
                {{leaderName}}
            </div>

        </div>


        <!-- TEAM INFO -->
        <div class="dashboard-card dashboard-reveal">

            <div class="section-heading">
                <div>
                    <span class="section-number">01</span>
                    <h2>Team Information</h2>
                </div>
            </div>

            <div class="leader-grid">

                <div class="info-box">
                    <span>TEAM ID</span>
                    <h3>{{teamId}}</h3>
                    <p>Team identifier</p>
                </div>

                <div class="info-box">
                    <span>TEAM NAME</span>
                    <h3>{{teamName}}</h3>
                    <p>Project team</p>
                </div>

                <div class="info-box">
                    <span>TEAM LEADER</span>
                    <h3>{{leaderName}}</h3>
                    <p>Primary contact</p>
                </div>

                <div class="info-box">
                    <span>COORDINATOR</span>
                    <h3>Coordinator {{coordinatorNumber}}</h3>
                    <p>Assigned coordinator</p>
                </div>

            </div>

        </div>


        <!-- HACKATHON INFORMATION -->
        <div class="dashboard-card dashboard-reveal">

            <div class="section-heading">

                <div>
                    <span class="section-number">02</span>
                    <h2>Hackathon Status</h2>
                </div>

            </div>

            <div class="info-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">

                <div class="info-box">
                    <span>SUBMISSION STATUS</span>
                    {{#if ../projectSettings.submissionOpen}}
                        <h3 style="color: #4caf50;">OPEN</h3>
                        <p>Ready to submit</p>
                    {{else}}
                        <h3 style="color: #f44336;">CLOSED</h3>
                        <p>No submissions allowed</p>
                    {{/if}}
                </div>

                <div class="info-box">
                    <span>CURRENT DEADLINE</span>
                    {{#if ../projectSettings.currentDeadline}}
                        <h3>{{dateFormat ../projectSettings.currentDeadline "MMM DD, h:MM A"}}</h3>
                        <p>Task deadline</p>
                    {{else}}
                        <h3>-</h3>
                        <p>No deadline set</p>
                    {{/if}}
                </div>

                <div class="info-box">
                    <span>ACTIVE TASKS</span>
                    <h3>{{../tasks.length}}</h3>
                    <p>Assigned to team</p>
                </div>

                <div class="info-box">
                    <span>YOUR SUBMISSION</span>
                    {{#if ../submissions.length}}
                        <h3 style="color: #4caf50;">SUBMITTED</h3>
                        <p>Last: {{dateFormat ../submissions.0.submittedAt "MMM DD, h:MM A"}}</p>
                    {{else}}
                        <h3 style="color: #ff9800;">PENDING</h3>
                        <p>Not submitted yet</p>
                    {{/if}}
                </div>

            </div>

        </div>


        <!-- ASSIGNED TASKS -->
        <div class="dashboard-card task-card dashboard-reveal">

            <div class="section-heading">

                <div>
                    <span class="section-number">03</span>
                    <h2>Assigned Tasks</h2>
                </div>

            </div>

            {{#if ../success}}
                <div class="alert alert-success" style="padding: 0.75rem 1rem; background: #003d00; border: 1px solid #4caf50; border-radius: 8px; color: #99ff99; margin-bottom: 1rem;">
                    ✓ {{../success}}
                </div>
            {{/if}}

            {{#if ../error}}
                <div class="alert alert-danger" style="padding: 0.75rem 1rem; background: #3d0000; border: 1px solid #f44336; border-radius: 8px; color: #ff9999; margin-bottom: 1rem;">
                    {{../error}}
                </div>
            {{/if}}

            {{#if ../tasks}}
                {{#each ../tasks}}
                    <div class="task-content" style="margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #16213e;">

                        <div class="task-main">

                            <span class="task-category">
                                Task
                            </span>

                            <h2 style="color: #3f36e7;">
                               {{this.head}}
                            </h2>

                            <p style="color: #999ba8; white-space: pre-line;">
                                {{this.message}}
                            </p>

                        </div>

                        <div class="task-details">

                            {{#if this.deadlineTime}}
                                <div>
                                    <span>DEADLINE</span>
                                    <strong style="color: #e0e0e0;">{{this.deadlineTime}}</strong>
                                </div>
                            {{/if}}

                            {{#if this.diff}}
                                <div>
                                    <span>DIFFICULTY</span>
                                    <strong style="color: #e0e0e0;">{{this.diff}}</strong>
                                </div>
                            {{/if}}

                            {{#if this.shareLink}}
                                <div>
                                    <span>SHARED RESOURCE</span>
                                    <a href="{{this.shareLink}}" target="_blank" rel="noopener noreferrer" style="color: #3f36e7;">
                                        Open Link →
                                    </a>
                                </div>
                            {{/if}}

                            <div>
                                <span>STATUS</span>
                                {{#if this.submitted}}
                                    <strong style="color: #4caf50;">✓ Submitted</strong>
                                {{else}}
                                    <strong style="color: #ff9800;">Pending</strong>
                                {{/if}}
                            </div>

                        </div>

                        <!-- RESPONSE FORM (per task) -->
                        {{#if this.submitted}}
                            <button disabled style="padding: 0.75rem 1.5rem; background: #171824; color: #4caf50; border: 1px solid #4caf50; border-radius: 6px; cursor: not-allowed;">
                                ✓ Response Submitted
                            </button>
                        {{else if @root.projectSettings.submissionOpen}}
                            <form action="/submit-task" method="POST" style="margin-top: 1rem;">

                                <input type="hidden" name="taskId" value="{{this._id}}">

                                <div class="form-group" style="margin-bottom: 1rem;">
                                    <label style="color: aliceblue; display: block; margin-bottom: 0.4rem;">Your Response</label>
                                    <textarea
                                        name="message"
                                        rows="4"
                                        required
                                        placeholder="Describe what you completed..."
                                        style="width: 100%; max-width: 100%; padding: 0.75rem; background: #171824; color: #e0e0e0; border: 1px solid #292a36; border-radius: 6px; resize: vertical;"
                                    ></textarea>
                                </div>

                                <div class="form-group" style="margin-bottom: 1rem;">
                                    <label style="color: aliceblue; display: block; margin-bottom: 0.4rem;">Project Link</label>
                                    <input
                                        type="url"
                                        name="projectLink"
                                        placeholder="https://github.com/username/project"
                                        required
                                        style="width: 100%; max-width: 100%; padding: 0.75rem; background: #171824; color: #e0e0e0; border: 1px solid #292a36; border-radius: 6px;"
                                    >
                                </div>

                                <button type="submit" class="submit-btn">
                                    Submit Response
                                    <span>→</span>
                                </button>

                            </form>
                        {{else}}
                            <div class="alert alert-warning" style="padding: 0.75rem 1rem; background: #3d2000; border: 1px solid #ff9800; border-radius: 8px; color: #ffcc99;">
                                Project submission is closed by the admin.
                            </div>
                        {{/if}}

                    </div>
                {{/each}}
            {{else}}
                <div class="alert alert-info" style="color: #999ba8;">
                    <p>No tasks assigned yet. Check back later!</p>
                </div>
            {{/if}}

        </div>

        <!-- MESSAGES FROM ADMIN/COORDINATOR -->
        {{#if ../messages}}
            <div class="dashboard-card dashboard-reveal">

                <div class="section-heading">

                    <div>
                        <span class="section-number">04a</span>
                        <h2>Messages</h2>
                    </div>

                </div>

                <div style="max-height: 400px; overflow-y: auto;">
                    {{#each ../messages}}
                        <div style="padding: 1rem; margin-bottom: 1rem; background: #171824; border: 1px solid #292a36; border-radius: 8px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <strong style="color: #3f36e7;">{{this.senderName}}</strong>
                                <small style="color: #777986;">{{dateFormat this.createdAt "MMM DD, h:MM A"}}</small>
                            </div>
                            <p style="color: #b0b0b0; margin: 0;">{{this.message}}</p>
                        </div>
                    {{/each}}
                </div>

            </div>
        {{/if}}


        <!-- SUBMISSION HISTORY -->

<div class="dashboard-card dashboard-reveal">

    <div class="section-heading">
        <div>
            <span class="section-number">05</span>
            <h2>Submission History</h2>
        </div>
    </div>

    {{#if ../submissions.length}}
        {{#each submissions}}
            <div style="padding: 1rem; margin-bottom: 1rem; background: #171824; border: 1px solid #292a36; border-radius: 8px;">
                <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <strong style="color: #4caf50;">✓ Submitted</strong>
                    <small style="color: #777986;">{{dateFormat this.submittedAt "MMM DD, h:MM A"}}</small>
                </div>
                <p style="color: #b0b0b0; margin: 0 0 0.5rem; white-space: pre-line;">{{this.message}}</p>
                {{#if this.projectLink}}
                    <a href="{{this.projectLink}}" target="_blank" rel="noopener noreferrer" style="color: #3f36e7;">Open Project →</a>
                {{/if}}
            </div>
        {{/each}}
    {{else}}
        <p style="color: #999ba8;">No submissions yet. Submit your response on a task above.</p>
    {{/if}}

</div>

{{/with}}
</section>

