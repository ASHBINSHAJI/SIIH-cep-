<section class="dashboard-section">

    <div class="container">

        <!-- HEADER -->
        <div class="dashboard-header dashboard-reveal">

            <div>
                <span class="dashboard-eyebrow">ADMIN PANEL</span>

                <h1>
                    Project
                    <span class="text-primary">Settings</span>
                </h1>

                <p>
                    Control project submission and task deadlines.
                </p>
            </div>

        </div>

        <!-- PROJECT SETTINGS -->
        <div class="dashboard-card dashboard-reveal">

            <div class="section-heading">
                <div>
                    <span class="section-number">01</span>
                    <h2>Submission & Deadline Control</h2>
                </div>

                <div>
                    <a href="/admin" class="btn btn-secondary">Back to Admin</a>
                </div>
            </div>

            {{#if updated}}
                <div class="alert alert-success" style="padding: 1rem; background: #003d00; border: 1px solid #4caf50; border-radius: 8px; color: #99ff99; margin-bottom: 1rem;">
                    ✓ Settings updated successfully
                </div>
            {{/if}}

            <form action="/admin/update-project-settings" method="POST">

                <div class="form-group" style="margin-bottom: 2rem; padding: 1.5rem; background: #171824; border: 1px solid #292a36; border-radius: 8px;">
                    <label style="color: aliceblue; display: block; margin-bottom: 1rem; font-weight: 600;">
                        Project Submission Status
                    </label>

                    <div style="display: flex; gap: 2rem;">
                        <label style="display: flex; align-items: center; color: #e0e0e0; cursor: pointer;">
                            <input 
                                type="radio" 
                                name="submissionOpen" 
                                value="true" 
                                {{#if settings.submissionOpen}}checked{{/if}}
                                style="margin-right: 0.5rem; cursor: pointer;"
                            > 
                            OPEN
                        </label>

                        <label style="display: flex; align-items: center; color: #e0e0e0; cursor: pointer;">
                            <input 
                                type="radio" 
                                name="submissionOpen" 
                                value="false" 
                                {{#unless settings.submissionOpen}}checked{{/unless}}
                                style="margin-right: 0.5rem; cursor: pointer;"
                            > 
                            CLOSED
                        </label>
                    </div>

                    <p style="color: #777986; font-size: 0.9rem; margin-top: 0.5rem;">
                        When CLOSED, teams cannot submit their projects.
                    </p>
                </div>

                <div class="form-group" style="margin-bottom: 2rem; padding: 1.5rem; background: #171824; border: 1px solid #292a36; border-radius: 8px;">
                    <label for="currentDeadline" style="color: aliceblue; display: block; margin-bottom: 0.5rem; font-weight: 600;">
                        Project Deadline
                    </label>

                    <input
                        type="datetime-local"
                        id="currentDeadline"
                        name="currentDeadline"
                        value="{{#if settings.currentDeadline}}{{settings.currentDeadline}}{{/if}}"
                        style="width: 100%; padding: 0.75rem; background: #0a0a14; color: #e0e0e0; border: 1px solid #292a36; border-radius: 6px; font-size: 1rem;"
                    >

                    <p style="color: #777986; font-size: 0.9rem; margin-top: 0.5rem;">
                        Set the final deadline for project submissions. Teams cannot submit after this time.
                    </p>
                </div>

                <div class="alert alert-info" style="padding: 1rem; background: #003d3d; border: 1px solid #00bcd4; border-radius: 8px; color: #99e0ff; margin-bottom: 1.5rem;">
                    <strong>ℹ️ Deadline Enforcement</strong>
                    <p style="margin-top: 0.5rem; margin-bottom: 0;">The server will automatically reject submissions after the deadline. The submission button on team dashboards will be disabled when the deadline passes.</p>
                </div>

                <button type="submit" class="submit-btn" style="padding: 0.75rem 2rem;">
                    Save Settings
                    <span>→</span>
                </button>

            </form>

        </div>

    </div>

</section>
